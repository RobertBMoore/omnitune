# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store

# Runtime state written into a host repo (never committed)
omnitune/.sync-state.json
omnitune/.model-usage.json
omnitune/.audit-ledger-*.json
*.tmp

# Rubric-change approval marker: a local, per-change human sign-off for the
# tighten-only / propose-only guards. Committing it would silently disable them.
.omnitune-approve-rubric

# Dogfood output artifacts (Mode A reports / Mode B saved prompts)
reports/
docs/prompts/

# Private denylist of client/company terms for check_public_clean (never publish)
scripts/.public-denylist.txt
